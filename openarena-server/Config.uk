# Config OpenArena Server application

config APPOPENARENASERVER
bool "A server for OpenArena, a community-produced deathmatch FPS based of GPL idTech3 technology"
default y
    select LIBVIRTIO_BUS
    select LIBVIRTIO_NET
    select VIRTIO_DEVICE
    select LIBUKBUS_PCI
    select LIBUKBUS_PLATFORM
    select LIBUKRANDOM_LCPU
    select LIBUKRANDOM_CMDLINE_SEED
    select LIBUKRANDOM_GETRANDOM
    select LIBUKRANDOM_DEVFS
    select LIBPOSIX_EVENTFD
    select LIBPOSIX_LIBDL
    select LIBPOSIX_USER
    select LIBUKVMEM
    select LIBPOSIX_MMAP
    select LIBVFSCORE
    select LIBVFSCORE_AUTOMOUNT_UP
    select LIBRAMFS
    select LIBUKCPIO
    select LIBDEVFS
    select LIBDEVFS_AUTOMOUNT
    select LIBDEVFS_DEVSTDOUT
    select LIBUKNETDEV_EINFO_LIBPARAM
    select LIBMUSL
    select LIBLWIP
    select LWIP_DEBUG
    select LWIP_UKNETDEV
	select LWIP_TCP
	select LWIP_WND_SCALE
	select LWIP_TCP_KEEPALIVE
	select LWIP_THREADS
	select LWIP_SOCKET
	select LWIP_AUTOIFACE
	select LWIP_IPV4
	select LWIP_IPV6
    select LWIP_DHCP
	select LWIP_DNS
    select LIBZLIB

