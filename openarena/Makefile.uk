$(eval $(call addlib,appopenarena))

CFLAGS_OA = -std=gnu11 -Wall -fno-strict-aliasing -Wimplicit -Wstrict-prototypes -pipe -DSTANDALONE -DPRODUCT_VERSION=\"3\" -Wformat=2 -Wno-format-zero-length \
	    -Wformat-security -Wno-format-nonliteral -Wstrict-aliasing=2 -Wmissing-format-attribute -Wdisabled-optimization -Werror-implicit-function-declaration -MMD -D__linux__
OPTIMIZE_OA = -DNDEBUG -O3 -fomit-frame-pointer -funroll-loops -ffast-math -flto
SERVER_CFLAGS_OA = -DUSE_VOIP

APPOPENARENA_CINCLUDES-y += -I$(APPOPENARENA_BASE)/code/asm
APPOPENARENA_CINCLUDES-y += -I$(APPOPENARENA_BASE)/code/botlib
APPOPENARENA_CINCLUDES-y += -I$(APPOPENARENA_BASE)/code/game
APPOPENARENA_CINCLUDES-y += -I$(APPOPENARENA_BASE)/code/null
APPOPENARENA_CINCLUDES-y += -I$(APPOPENARENA_BASE)/code/qcommon
APPOPENARENA_CINCLUDES-y += -I$(APPOPENARENA_BASE)/code/server
APPOPENARENA_CINCLUDES-y += -I$(APPOPENARENA_BASE)/code/sys

APPOPENARENA_SRCS-y += $(APPOPENARENA_BASE)/code/server/sv_bot.c
APPOPENARENA_SV_BOT_FLAGS-y += -DDEDICATED $(CFLAGS_OA) $(SERVER_CFLAGS_OA) $(OPTIMIZE_OA)

APPOPENARENA_SRCS-y += $(APPOPENARENA_BASE)/code/server/sv_client.c
APPOPENARENA_SV_CLIENT_FLAGS-y += -DDEDICATED $(CFLAGS_OA) $(SERVER_CFLAGS_OA) $(OPTIMIZE_OA)

